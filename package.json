{
  "name": "pi-simple-web-ui",
  "version": "0.1.0",
  "description": "A minimal browser check-in companion for Pi sessions",
  "keywords": [
    "pi",
    "pi-package",
    "web-ui"
  ],
  "homepage": "https://github.com/tudoroancea/pi-simple-web-ui#readme",
  "bugs": {
    "url": "https://github.com/tudoroancea/pi-simple-web-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tudoroancea/pi-simple-web-ui.git"
  },
  "type": "module",
  "scripts": {
    "check": "nub run format:check && nub run lint && nub run typecheck && nub run test:e2e",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tudoroancea/pi-simple-web-ui/main/docs/assets/pi-simple-web-ui.png"
  }
}
